# Copy to .env and fill in. .env is gitignored — never commit real values.

# Where Chroma persists its data on disk.
CHROMA_DB_PATH=./chroma_data

# Name of the Chroma collection embedding views are written into.
CHROMA_COLLECTION=contract_clauses

# Embedding model identifier (backend TBD — placeholder for whichever
# embedding provider/model retrieval/ ends up calling).
EMBEDDING_MODEL=
