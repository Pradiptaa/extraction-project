# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# Mistral
# ---------------------------------------------------------------------------
# Create a key at https://console.mistral.ai/ -> API Keys.
MISTRAL_API_KEY=

# Pinned deliberately. The embedding model is part of the Chroma collection
# name, so changing this value routes writes to a NEW collection instead of
# appending vectors of a different dimension into the existing one.
# Never "upgrade" this in place without a full re-embed.
EMBEDDING_MODEL=mistral-embed

# Nodes per embedding request. Lower this first if you hit 429s.
EMBEDDING_BATCH_SIZE=64

# Seconds to wait before each embedding request. The whole corpus is only ~63
# requests, so pacing costs seconds, while tripping a per-second cap costs a
# cascade of 429s and backoff sleeps. Raise this (not just the batch size) if
# 429s persist; set it to 0 on a paid tier where the cap is not the constraint.
EMBEDDING_REQUEST_DELAY=0.3

# Chat model for `retrieval.ask --synthesizer mistral`. Optional: leave it
# empty and everything except synthesis still works, including the retrieval
# gate. Pinned for the same reason EMBEDDING_MODEL is — an answer that cannot be
# attributed to a known model version is not reproducible.
#
# Note the same caveat as the embedding model: `-latest` is a moving alias, so
# an answer recorded today may not be reproducible tomorrow. Prefer a dated
# model id if one is available for the model you pick.
#
# FREE-TIER AVAILABILITY (measured 2026-09-14, not documented anywhere obvious):
# the premier models return 429 "Rate limit exceeded" immediately and forever on
# a free account, while the open-weight ones work fine. Verified by calling each:
#   mistral-small-latest   429      ministral-3b-latest    OK
#   mistral-medium-latest  429      ministral-8b-latest    OK
#                                   open-mistral-7b        OK
#                                   open-mistral-nemo      OK
# So a 429 here does NOT necessarily mean you are out of quota — embeddings kept
# working throughout. Try an open model before concluding anything about budget.
# open-mistral-nemo is the default because it is the strongest multilingual one
# of the four, and this corpus is Indonesian.
CHAT_MODEL=open-mistral-nemo

# ---------------------------------------------------------------------------
# Chroma
# ---------------------------------------------------------------------------
# Where Chroma persists its data on disk. Relative paths resolve from the
# JSONextraction/ directory. Keep this out of git — it is generated data.
CHROMA_DB_PATH=./chroma_data

# Collection names are DERIVED, not set directly: the loader appends the
# embedding model and the embedding-view schema version to this prefix, e.g.
#   contracts__mistral-embed__v2_0_0
# so a model or schema change can never silently write mismatched dimensions
# into an existing collection.
CHROMA_COLLECTION_PREFIX=contracts

# chromadb 0.5.23 emits "Failed to send telemetry event ... capture() takes 1
# positional argument" on every call — a harmless version mismatch with its
# posthog dependency, but it buries real log output. Off by default.
ANONYMIZED_TELEMETRY=False
