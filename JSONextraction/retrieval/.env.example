# MISTRAL_API_KEY=
# EMBEDDING_MODEL=mistral-embed
EMBEDDING_MODEL=bge-m3
EMBEDDING_BATCH_SIZE=64
# EMBEDDING_REQUEST_DELAY=0.3

# CHAT_MODEL=open-mistral-nemo
# CHAT_MODEL=qwen2.5:3b-instruct
CHAT_MODEL=qwen2.5:7b

OLLAMA_HOST=http://localhost:11434
OLLAMA_NUM_CTX=8192
# Embed a query on the CPU so it does not evict the chat model from a GPU
# too small to hold both: 15 ms slower per query, ~10 s faster per answer.
# Bulk loading ignores this and uses the GPU, where it is 2.8x faster.
QUERY_EMBED_ON_CPU=true

CHROMA_DB_PATH=./chroma_data
# CHROMA_COLLECTION_PREFIX=contracts
CHROMA_COLLECTION_PREFIX=contracts_rel
ANONYMIZED_TELEMETRY=False
